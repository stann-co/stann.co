# Cloudflare static-asset headers (https://developers.cloudflare.com/workers/static-assets/headers/)

# basic hardening for every response. no CSP: the gallery hotlinks media from
# twimg and fonts from Google, and a CSP would need to track all of that.
/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: no-referrer
  Permissions-Policy: camera=(), microphone=(), geolocation=()

# Astro fingerprints everything under /_astro/ (the filename changes whenever
# the content does), so browsers can cache these forever.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable
