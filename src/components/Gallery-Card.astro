---
// A single art-bookmarks gallery card.
//
// justified-layout computes box geometry from the live container width, so
// cards are positioned at runtime in the browser — they can't be server-
// rendered with final coordinates. This component therefore ships a
// <template> that the art-bookmarks client script clones and fills in per
// media item, keeping the card markup in one place instead of inline strings.
//
// Card styling lives in src/styles/global.css (.gallery .box).

// true only on the local dev server (bun run dev); always false in the
// production build, so the admin tag toggles never ship to stann.co.
const LOCAL_ADMIN = import.meta.env.DEV;

// category/sorting tags applied to media in dev mode. Keep in sync with the
// TAGS list in astro.config.mjs (which validates + persists them).
// ("animated" and "painting" aren't here — animated is derived from a media
// item's type (video/animated_gif), and painting is the implicit default for
// any item with no tags, so neither is ever applied by hand.)
const TAGS = ["sketch", "3d", "pixelart", "irl"];
---

<template id="gallery-card">
	<div class="box">
		<a target="_blank" rel="noopener noreferrer">
			<img loading="lazy" />
		</a>
		<span class="artist-label"></span>
		{LOCAL_ADMIN && (
			<Fragment>
				<div class="admin-tags">
					<button class="checked-toggle" type="button" aria-pressed="false">✓ seen</button>
					<button class="nsfw-toggle" type="button" aria-pressed="false">NSFW</button>
					{TAGS.map((t) => (
						<button class="tag-toggle" data-tag={t} type="button" aria-pressed="false">{t}</button>
					))}
				</div>
				<button class="delete-post" type="button" title="Delete this post">✕</button>
			</Fragment>
		)}
	</div>
</template>
